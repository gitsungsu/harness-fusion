    { "dot": "violet", "title": "세 역할 (같은 Providers 경로)", "items": [
      "Planner: PRD를 읽고 작업 계획 JSON만 반환 (read-only)",
      "Generator: 작업의 touch 범위 안에서만 구현 (workspace-write)",
      "Evaluator: 소스·검사 결과를 읽고 평가 JSON 반환 (read-only)"
    ] },
    { "dot": "cyan", "title": "엔진 상태 흐름", "items": [
      "NEW → PLANNING → IMPLEMENTING → VERIFYING (작업마다 반복)",
      "작업 실패 시 max_attempts 안에서 재시도, 소진되면 HALTED",
      "모든 작업 통과 후 FINAL_CHECK → DONE (모델은 DONE을 쓸 수 없음)"
    ] },
    { "dot": "rose", "title": "완료 게이트 (모두 만족해야 통과)", "items": [
